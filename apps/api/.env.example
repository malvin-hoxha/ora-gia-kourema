NODE_ENV=development
PORT=4000

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# false for local/direct access.
# Set an exact hop count only after confirming
# the production reverse-proxy architecture.
TRUST_PROXY=false

BARBERSHOP_TIME_ZONE=Europe/Athens

DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST-pooler/DATABASE_NAME?sslmode=require
DIRECT_URL=postgresql://USERNAME:PASSWORD@HOST/DATABASE_NAME?sslmode=require

JWT_ACCESS_SECRET=your_long_random_access_secret
JWT_REFRESH_SECRET=your_long_random_refresh_secret

ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30

GOOGLE_CLIENT_ID=000000000000-placeholder.apps.googleusercontent.com

STRIPE_SECRET_KEY=
STRIPE_CURRENCY=eur
STRIPE_CHECKOUT_EXPIRES_MINUTES=30
STRIPE_WEBHOOK_SECRET=

EMAIL_ENABLED=false
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=OraGiaKourema
EMAIL_FROM_ADDRESS=appointments@example.com
RESEND_API_KEY=

# Optional privileged accounts used only when explicitly seeding them.
SEED_BARBER_PASSWORD=
SEED_ADMIN_PASSWORD=
